# AI Dating Assistant — Environment Variables
#
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
#   chmod 600 .env
#
# NEVER commit .env to version control.
# The .gitignore already excludes it.

# ── Telegram API Credentials ──────────────────────────────────────────────────
# Get these from: https://my.telegram.org/apps
# Log in with your phone number → create an application → copy the values below
TELEGRAM_API_ID=YOUR_API_ID_HERE
TELEGRAM_API_HASH=YOUR_API_HASH_HERE

# ── Google Gemini API Key ──────────────────────────────────────────────────────
# Get this from: https://aistudio.google.com → Get API key
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ── Optional ──────────────────────────────────────────────────────────────────
# Enable structured JSON logging (for Loki, Datadog, CloudWatch, etc.)
# Default: false (plain text logs)
# STRUCTURED_LOGGING=true
